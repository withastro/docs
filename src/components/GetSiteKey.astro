---
import { useTranslations } from '~/i18n/util';
import { pageKey } from '~/util/elementIds';
import { linkIntent } from '~/util/intent';
import { signupEventClasses, signupHref, type SignupPlacement } from '~/util/signup';

interface Props {
	placement?: SignupPlacement;
}

const { placement = 'inline' } = Astro.props;
const t = useTranslations(Astro);
const href = signupHref(Astro.url.pathname, placement);
const copy = {
	inline: {
		title: t('siteKeyCta.inline.title'),
		body: t('siteKeyCta.inline.body'),
		button: t('siteKeyCta.button'),
	},
	sidebar: {
		title: t('siteKeyCta.sidebar.title'),
		body: t('siteKeyCta.sidebar.body'),
		button: t('siteKeyCta.button'),
	},
	production: {
		title: t('siteKeyCta.production.title'),
		body: t('siteKeyCta.production.body'),
		button: t('siteKeyCta.productionButton'),
	},
}[placement];
---

<aside class:list={['site-key-cta not-content', placement]}>
	<p class="title">{copy.title}</p>
	<p class="body">{copy.body}</p>
	<a
		class:list={['button', signupEventClasses(placement)]}
		href={href}
		data-el={`${pageKey(Astro.url.pathname)}.get-site-key-${placement}`}
		data-intent={linkIntent(href)}
	>
		{copy.button}
	</a>
</aside>

<style>
	.site-key-cta {
		margin-block: 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 0.5rem;
		background: var(--sl-color-accent-low);
	}
	.site-key-cta.sidebar {
		margin-block: 1rem 0;
		padding: 0.75rem 1rem;
	}
	.title {
		margin: 0;
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.body {
		margin: 0.25rem 0 0.75rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.button {
		display: inline-block;
		border-radius: 999rem;
		padding: 0.5rem 1.125rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
	}
	.button:hover {
		background: var(--sl-color-white);
	}
	.site-key-cta.sidebar .button {
		display: block;
		text-align: center;
	}
</style>
